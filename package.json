{
  "name": "opentrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opentrack: a self-hosted, open-source Jira alternative. Projects, issues, kanban boards, sprints, reports, time tracking and an MCP server for AI assistants. Runs on Cloudflare Workers + D1 or Node + Postgres (Google Cloud Run).",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/node.js",
    "build": "vite build",
    "deploy": "npm run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy:cf": "npm run build && npm run deploy",
    "test": "vitest run",
    "start": "node server/node.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "dompurify": "^3.4.18",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "modern-screenshot": "^4.7.0",
    "pg": "^8.23.1",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Secret you type once at `/setup` to create the first admin. Generate one with `openssl rand -hex 24` and keep it somewhere safe."
      }
    }
  }
}
